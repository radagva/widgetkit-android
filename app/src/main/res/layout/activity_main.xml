<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:text="@string/settings_title"
            android:textColor="@color/app_label"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- ───────────── Calendar ───────────── -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_calendar" />

        <FrameLayout style="@style/SettingsPreviewBackdrop">

            <FrameLayout
                android:id="@+id/preview_calendar"
                android:layout_width="match_parent"
                android:layout_height="160dp" />
        </FrameLayout>

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_scheme" />

        <LinearLayout
            android:id="@+id/scheme_list_calendar"
            style="@style/SettingsList" />

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_access" />

        <LinearLayout
            style="@style/SettingsCard"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/access_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/app_label"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/access_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_access_allow"
                android:textAllCaps="false"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actions_calendar"
            style="@style/SettingsList"
            android:layout_marginTop="16dp" />

        <TextView
            style="@style/SettingsFooter"
            android:text="@string/settings_footer_calendar" />

        <!-- ───────────── Currency ───────────── -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:layout_marginTop="36dp"
            android:text="@string/settings_section_currency" />

        <LinearLayout
            style="@style/SettingsPreviewBackdrop"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/preview_usd"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1" />

                <Space
                    android:layout_width="16dp"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/preview_eur"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/preview_both"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_scheme" />

        <LinearLayout
            android:id="@+id/scheme_list_currency"
            style="@style/SettingsList" />

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_sources" />

        <LinearLayout
            android:id="@+id/sources_list"
            style="@style/SettingsList" />

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_display" />

        <LinearLayout
            style="@style/SettingsCard"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_show_change"
                    android:textColor="@color/app_label"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_show_change_hint"
                    android:textColor="@color/app_secondary_label"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/show_change_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actions_currency"
            style="@style/SettingsList"
            android:layout_marginTop="16dp" />

        <TextView
            style="@style/SettingsFooter"
            android:text="@string/settings_footer_currency" />

        <!-- App version + share download link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/app_secondary_label"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/share_version"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_share_version"
                android:padding="11dp"
                android:src="@drawable/ic_share"
                android:tint="@color/app_tint" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
