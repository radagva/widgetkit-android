<?xml version="1.0" encoding="utf-8"?>
<!-- Settings screen. Rows inside the cards are built in MainActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:text="@string/settings_title"
            android:textColor="@color/app_label"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Global options -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_global" />

        <LinearLayout
            android:id="@+id/global_list"
            style="@style/SettingsList" />

        <TextView
            style="@style/SettingsFooter"
            android:text="@string/settings_global_footer" />

        <!-- Tools -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_tools" />

        <LinearLayout
            android:id="@+id/tools_list"
            style="@style/SettingsList" />

        <TextView
            style="@style/SettingsFooter"
            android:text="@string/settings_tools_footer" />

        <!-- UUID generator (shared with the UUID widget) -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_uuid" />

        <LinearLayout
            android:id="@+id/uuid_list"
            style="@style/SettingsList" />

        <TextView
            style="@style/SettingsFooter"
            android:text="@string/settings_uuid_footer" />

        <!-- Widgets: accordion, one open at a time -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_widgets" />

        <LinearLayout
            android:id="@+id/accordion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Credits -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:layout_marginTop="36dp"
            android:text="@string/settings_section_credits" />

        <LinearLayout
            android:id="@+id/credits_list"
            style="@style/SettingsList" />

        <TextView
            style="@style/SettingsFooter"
            android:text="@string/settings_credits_footer" />

        <!-- App version + share download link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/app_secondary_label"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/share_version"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_share_version"
                android:padding="11dp"
                android:src="@drawable/ic_share"
                android:tint="@color/app_tint" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
