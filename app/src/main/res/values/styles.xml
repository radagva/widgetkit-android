<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SettingsSectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/app_secondary_label</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/app_card</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- A grouped list card whose rows are added in code. -->
    <style name="SettingsList">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/app_card</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingsPreviewBackdrop">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/app_preview_backdrop</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="SettingsFooter">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:textColor">@color/app_secondary_label</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Rounded app icon in the update sheet. -->
    <style name="UpdateSheetIconShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
</resources>
